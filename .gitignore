# =========================================================================
# Orbiter — .gitignore
#
# Per-subsystem .gitignore files in subdirs:
#   docker/.gitignore — .env, ./data/
# =========================================================================

# ── Python ───────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
*.egg
.pytest_cache/
.mypy_cache/
.ruff_cache/
.tox/
.coverage
.coverage.*
htmlcov/
*.cover

# Virtualenvs (any conventional name, anywhere in the tree)
.venv/
venv/
env/
ENV/

# ── Node / Vite (ui/) ────────────────────────────────────────────────────
node_modules/
.vite/
*-debug.log*

# ── ESP-IDF (firmware/) ──────────────────────────────────────────────────
firmware/build/
firmware/managed_components/
# sdkconfig contains Wi-Fi credentials baked in at build time — never commit.
# sdkconfig.defaults IS committed (default values applied to a fresh sdkconfig
# by menuconfig).
firmware/sdkconfig
firmware/sdkconfig.old

# ── Build artifacts (catches python build/, vite dist/, anything build/) ─
build/
dist/
*.tsbuildinfo

# ── colmap-quick lab utility (tools/colmap-quick/) ───────────────────────
# Generated reconstruction workspaces: staged image copies, database.db,
# sparse/, dense/ and the fused .ply — all regenerable, never commit.
*_recon/

# ── Object-mask tool (colmap/masks/) ─────────────────────────────────────
# SAM2 checkpoints are downloaded by the operator (see colmap/masks/README.md)
# — hundreds of MB, never commit.
colmap/masks/models/

# ── Server-local dev artifacts ───────────────────────────────────────────
# rig_model.py resolves the rig GLB from cad/assembly/Orbiter.glb (canonical)
# with server/Orbiter.glb as an optional local override — never commit the
# copy.
server/Orbiter.glb
# Scan-session storage (manifests, captures, persisted ModelState).
server/data/

# ── native/ scanner (native/) ────────────────────────────────────────────
# Clouds written by the scan panel — regenerable, never commit.
scan.ply
native/scan.ply

# ── Agent/session state ──────────────────────────────────────────────────
.omc/

# ── IDE ──────────────────────────────────────────────────────────────────
.idea/
.vscode/
*.swp
*.swo

# ── OS ───────────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
desktop.ini

# ── Logs / temp ──────────────────────────────────────────────────────────
*.log
*.tmp

# ── Env files (docker/.env is handled by docker/.gitignore) ──────────────
/.env
/.env.local
.env.*.local
# Per-deployment server config with real IPs/URLs — copy server/.env.example
# to server/.env. The template (.env.example) IS committed.
server/.env
